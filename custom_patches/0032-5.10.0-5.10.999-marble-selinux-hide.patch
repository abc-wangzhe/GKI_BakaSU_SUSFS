diff --git a/security/selinux/hooks.c b/security/selinux/hooks.c
index d2566870e4ab..abff4c293ca4 100644
--- a/security/selinux/hooks.c
+++ b/security/selinux/hooks.c
@@ -6446,6 +6446,59 @@ static int selinux_getprocattr(struct task_struct *p,
 	return error;
 }
 
+/*
+ * marble: make root-tool contexts look non-existent to app processes.
+ *
+ * A detector writes candidate context strings to /proc/self/attr/current and
+ * distinguishes "type exists" (EACCES from the PROCESS__SETCURRENT check)
+ * from "type does not exist" (EINVAL from the parser). On a rooted device the
+ * root-manager and hook-framework types exist, so they answer EACCES and the
+ * detector learns the device is rooted even when every runtime trace is
+ * hidden.
+ *
+ * For app uids we therefore reject those strings as unknown types *before*
+ * the permission check, which is exactly what a stock policy answers.
+ * Root and system uids (ksud, init, system_server) are untouched.
+ */
+static const char * const marble_hidden_proc_types[] = {
+	"ksu", "ksu_file", "ksu_data",
+	"lsposed", "lsposed_file", "lsposed_data",
+	"magisk", "magisk_file", "magisk_data",
+	"xposed_file", "xposed_data",
+	"adbroot", "droidspacesd", "msd_app", "msd_daemon",
+};
+
+static bool marble_proc_context_hidden(const char *value, size_t size)
+{
+	const char *p, *type_start;
+	size_t type_len;
+	int i;
+
+	if (uid_eq(current_uid(), GLOBAL_ROOT_UID) || current_uid().val < 10000)
+		return false;
+	if (!value || !size)
+		return false;
+
+	/* context layout: user:role:type[:sensitivity[:categories]] */
+	p = strchr(value, ':');
+	if (!p)
+		return false;
+	p = strchr(p + 1, ':');
+	if (!p)
+		return false;
+	type_start = p + 1;
+	p = strchr(type_start, ':');
+	type_len = p ? (size_t)(p - type_start) : strlen(type_start);
+
+	for (i = 0; i < ARRAY_SIZE(marble_hidden_proc_types); i++) {
+		const char *t = marble_hidden_proc_types[i];
+
+		if (strlen(t) == type_len && !strncmp(type_start, t, type_len))
+			return true;
+	}
+	return false;
+}
+
 static int selinux_setprocattr(const char *name, void *value, size_t size)
 {
 	struct task_security_struct *tsec;
@@ -6454,6 +6507,14 @@ static int selinux_setprocattr(const char *name, void *value, size_t size)
 	int error;
 	char *str = value;
 
+	/*
+	 * marble: answer hidden root-tool types the way a stock policy would
+	 * (unknown type -> EINVAL) before the permission check can reveal
+	 * that the type exists. See marble_proc_context_hidden().
+	 */
+	if (!strcmp(name, "current") && marble_proc_context_hidden(value, size))
+		return -EINVAL;
+
 	/*
 	 * Basic control over ability to set these attributes at all.
 	 */
