+/*
+ * marble: hide root-tool SELinux types from app-visible selinuxfs probes.
+ *
+ * Detection suites run inside app_zygote / untrusted_app and ask selinuxfs
+ * whether privileged context strings exist. The kernel answers differently
+ * for a context that exists (EACCES from the later permission check) than
+ * for one that does not (EINVAL while parsing), which tells a detector
+ * whether the device carries root-manager or hook-framework policy types.
+ *
+ * The check is applied at the selinuxfs entry points only, so the generic
+ * in-kernel context plumbing (secctx -> secid used by real file labels) is
+ * untouched. Only umounted app uids are affected; root and system uids keep
+ * the original behaviour.
+ */
+static const char * const marble_hidden_selinux_types[] = {
+	"ksu", "ksu_file", "ksu_data",
+	"lsposed", "lsposed_file", "lsposed_data",
+	"magisk", "magisk_file", "magisk_data",
+	"xposed_file", "xposed_data",
+};
+
+static bool marble_is_app_uid(void)
+{
+	if (uid_eq(current_uid(), GLOBAL_ROOT_UID))
+		return false;
+	return current_uid().val >= 10000;
+}
+
+static bool marble_context_is_hidden(const char *scon)
+{
+	const char *p, *type_start;
+	size_t type_len;
+	int i;
+
+	if (!marble_is_app_uid() || !scon)
+		return false;
+
+	/* context layout: user:role:type[:sensitivity[:categories]] */
+	p = strchr(scon, ':');
+	if (!p)
+		return false;
+	p = strchr(p + 1, ':');
+	if (!p)
+		return false;
+	type_start = p + 1;
+	p = strchr(type_start, ':');
+	type_len = p ? (size_t)(p - type_start) : strlen(type_start);
+
+	for (i = 0; i < ARRAY_SIZE(marble_hidden_selinux_types); i++) {
+		const char *t = marble_hidden_selinux_types[i];
+
+		if (strlen(t) == type_len && !strncmp(type_start, t, type_len))
+			return true;
+	}
+	return false;
+}
+
 static ssize_t sel_write_context(struct file *file, char *buf, size_t size)
 {
 	struct selinux_fs_info *fsi = file_inode(file)->i_sb->s_fs_info;
@@ -688,6 +746,11 @@ static ssize_t sel_write_context(struct file *file, char *buf, size_t size)
 	if (length)
 		goto out;
 
+	if (marble_context_is_hidden(buf)) {
