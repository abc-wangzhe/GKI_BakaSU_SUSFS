+		 * sepolicy.rule; stock system_server.te has no execute on
+		 * apk_data_file. Report the stock verdict so the viability of
+		 * the rule stops being an observable LSPosed fingerprint.
+		 */
+		if (marble_system_server_type &&
+		    s_type == marble_system_server_type &&
+		    marble_apk_data_file_type &&
+		    t_type == marble_apk_data_file_type) {
+			mask = MARBLE_FILE_EXECUTE;
+			goto mask_out;
+		}
