+/*
+ * marble: answer root-tool context strings the way a stock policy would.
+ *
+ * Detection suites write candidate contexts to /proc/self/attr/current from an
+ * app_zygote/app carrier and distinguish "type exists" (EACCES from the
+ * PROCESS__SETCURRENT check) from "unknown type" (EINVAL). Rooted devices
+ * carry ksu/lsposed/magisk types, so those probes answer EACCES and reveal
+ * root even when every runtime artifact is hidden.
+ *
+ * This hook lives in the LSM dispatch layer so it runs before any stacking
+ * hook (including the SUSFS-injected my_setprocattr) can answer for the
+ * hidden types. Only umounted app uids are affected.
+ */
+static const char * const marble_hidden_proc_types[] = {
+	"ksu", "ksu_file", "ksu_data",
+	"lsposed", "lsposed_file", "lsposed_data",
+	"magisk", "magisk_file", "magisk_data",
+	"xposed_file", "xposed_data",
+	"adbroot", "droidspacesd", "msd_app", "msd_daemon",
+};
+
+static bool marble_selinux_hidden_type(const char *value, size_t size)
+{
+	const char *p, *type_start;
+	size_t type_len;
+	int i;
+
+	if (uid_eq(current_uid(), GLOBAL_ROOT_UID) || current_uid().val < 10000)
+		return false;
+	if (!value || size < 5)
+		return false;
+
+	/* context layout: user:role:type[:sensitivity[:categories]] */
+	p = strchr(value, ':');
+	if (!p)
+		return false;
+	p = strchr(p + 1, ':');
+	if (!p)
+		return false;
+	type_start = p + 1;
+	p = memchr(type_start, ':', size - (size_t)(type_start - (const char *)value));
+	type_len = p ? (size_t)(p - type_start) : strlen(type_start);
+
+	for (i = 0; i < ARRAY_SIZE(marble_hidden_proc_types); i++) {
+		const char *t = marble_hidden_proc_types[i];
+
+		if (strlen(t) == type_len && !strncmp(type_start, t, type_len))
+			return true;
+	}
+	return false;
+}
