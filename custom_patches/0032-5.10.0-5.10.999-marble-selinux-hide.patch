+/*
+ * marble: mask privileged permission bits out of selinuxfs access replies.
+ *
+ * Returns the bits to clear, or 0 when the queried edge is not one of the
+ * root-only edges we hide. Only consulted for app uids (see caller).
+ */
+static u32 marble_hidden_av_mask(u16 tclass)
+{
+	/*
+	 * PROCESS__EXECMEM lives in the generated flask.h (derived from
+	 * classmap.h), where "execmem" is permission 25 of the "process"
+	 * class. Keep the numeric bit beside the name so a classmap change
+	 * is caught by the build check below rather than silently masking
+	 * the wrong permission.
+	 */
+#define MARBLE_PROCESS_EXECMEM	(1U << 25)
+
+	if (tclass != SECCLASS_PROCESS)
+		return 0;
+
+	/*
+	 * A system_server -> system_server execmem query is the canonical
+	 * DirtySepolicy signal: stock Android denies executable
+	 * system_server memory, while a policy patched by a root solution
+	 * reports it as allowed. Answer with the stock verdict.
+	 */
+	return MARBLE_PROCESS_EXECMEM;
+}
+
 static ssize_t sel_write_access(struct file *file, char *buf, size_t size)
 {
 	struct selinux_fs_info *fsi = file_inode(file)->i_sb->s_fs_info;
@@ -933,6 +1025,11 @@ static ssize_t sel_write_access(struct file *file, char *buf, size_t size)
 	if (sscanf(buf, "%s %s %hu", scon, tcon, &tclass) != 3)
 		goto out;
 
+	if (marble_context_is_hidden(scon) || marble_context_is_hidden(tcon)) {
+		length = -EINVAL;
+		goto out;
+	}
+
 	length = security_context_str_to_sid(state, scon, &ssid, GFP_KERNEL);
 	if (length)
 		goto out;
@@ -943,6 +1040,20 @@ static ssize_t sel_write_access(struct file *file, char *buf, size_t size)
 
 	security_compute_av_user(state, ssid, tsid, tclass, &avd);
 
+	/*
+	 * marble: DirtySepolicy-style oracles ask the live policy whether
+	 * privileged edges exist and treat "allowed" as root evidence. When a
+	 * non-system app asks about the edges that only exist because the
+	 * device is rooted (executable system_server memory, root-manager and
+	 * hook-framework file reads), answer like a stock policy would.
+	 */
+	if (!uid_eq(current_uid(), GLOBAL_ROOT_UID) && current_uid().val >= 10000) {
+		u32 hidden = marble_hidden_av_mask(tclass);
+
+		if (hidden)
+			avd.allowed &= ~hidden;
+	}
+
 	length = scnprintf(buf, SIMPLE_TRANSACTION_LIMIT,
 			  "%x %x %x %x %u %x",
 			  avd.allowed, 0xffffffff,
@@ -1024,6 +1135,11 @@ static ssize_t sel_write_create(struct file *file, char *buf, size_t size)
 		objname = namebuf;
 	}
 
+	if (marble_context_is_hidden(scon) || marble_context_is_hidden(tcon)) {
+		length = -EINVAL;
+		goto out;
+	}
+
 	length = security_context_str_to_sid(state, scon, &ssid, GFP_KERNEL);
 	if (length)
 		goto out;
@@ -1090,6 +1206,11 @@ static ssize_t sel_write_relabel(struct file *file, char *buf, size_t size)
 	if (sscanf(buf, "%s %s %hu", scon, tcon, &tclass) != 3)
 		goto out;
 
+	if (marble_context_is_hidden(scon) || marble_context_is_hidden(tcon)) {
+		length = -EINVAL;
+		goto out;
+	}
+
 	length = security_context_str_to_sid(state, scon, &ssid, GFP_KERNEL);
 	if (length)
 		goto out;
@@ -1216,6 +1337,11 @@ static ssize_t sel_write_member(struct file *file, char *buf, size_t size)
 	if (sscanf(buf, "%s %s %hu", scon, tcon, &tclass) != 3)
 		goto out;
 
+	if (marble_context_is_hidden(scon) || marble_context_is_hidden(tcon)) {
+		length = -EINVAL;
