 int security_setprocattr(const char *lsm, const char *name, void *value,
 			 size_t size)
 {
 	struct security_hook_list *hp;
 
+	/*
+	 * marble: make root-manager / hook-framework types look like unknown
+	 * types to app processes. Placed before the stacking loop so no LSM
+	 * hook (SUSFS my_setprocattr included) can answer for them first.
+	 */
+	/*
+	 * /proc/<pid>/attr/current is registered with lsm == NULL (see the
+	 * attr_dir_stuff table in fs/proc/base.c), so match on the bare name
+	 * and let each stacked hook see the call otherwise.
+	 */
+	if (!strcmp(name, "current") &&
+	    marble_selinux_hidden_type(value, size))
+		return -EINVAL;
+
 	hlist_for_each_entry(hp, &security_hook_heads.setprocattr, list) {
 		if (lsm != NULL && strcmp(lsm, hp->lsm))
 			continue;
