+
+/*
+ * marble: identify a class by its name in the loaded policy.
+ *
+ * Never compare tclass against the compile-time SECCLASS_* constants.
+ * Those are indices into classmap.h, which lists process2 right after
+ * process. A policy that binds process2 last shifts every class after it
+ * — Android does exactly that: this device reports process2 = 93 while
+ * classmap.h puts it at 3, so SECCLASS_FILE (7 in classmap.h) addresses
+ * "dir" at runtime while the policy's own "file" is 6. A mask keyed on
+ * SECCLASS_FILE therefore clears a bit of the wrong class and the real
+ * edge stays allowed.
+ *
+ * The policy's SYM_CLASSES table is the only authoritative mapping for
+ * the tclass value this function receives.
+ */
+static bool marble_class_is(struct policydb *policydb, u16 tclass,
+			    const char *name)
+{
+	const char *tclass_name;
+
+	if (!policydb || !tclass)
+		return false;
+
+	tclass_name = sym_name(policydb, SYM_CLASSES, tclass - 1);
+	return tclass_name && !strcmp(tclass_name, name);
+}
