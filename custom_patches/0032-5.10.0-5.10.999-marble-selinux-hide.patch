diff --git a/security/selinux/ss/services.c b/security/selinux/ss/services.c
index 0a5e197a2c75..ff762c9ccb3d 100644
--- a/security/selinux/ss/services.c
+++ b/security/selinux/ss/services.c
@@ -1172,6 +1172,169 @@ void security_compute_av(struct selinux_state *state,
 	goto out;
 }
 
+#ifdef CONFIG_SECURITY_SELINUX
+/*
+ * marble: mask privileged edges out of app-visible AV queries.
+ *
+ * Two exposure families make a rooted device distinguishable from stock:
+ *
+ *   1. PROCESS__EXECMEM between system_server and itself. Stock denies
+ *      executable system_server memory; a policy patched by a root solution
+ *      reports it allowed and DirtySepolicy-style oracles read that as proof.
+ *
+ *   2. FILE__READ against root-manager / hook-framework file types that only
+ *      exist on a rooted device.
+ *
+ * Only app uids see the masked verdict, so init, system_server, ksud and the
+ * root shell keep the real policy. Type values are resolved once when the
+ * policy loads and afterwards compared as integers, which is RCU-safe and free
+ * on the hot path.
+ */
+/*
+ * Permission bit positions. These come from security/selinux/include/
+ * classmap.h, which is the single source of truth for class/perm numbering:
+ *
+ *   process: fork, transition, ..., setcurrent, execmem(25), execstack, ...
+ *   file   : ioctl, read(0), write, ...
+ *
+ * If a future kernel inserts a permission before these entries the mask would
+ * silently target the wrong bit, so the values are re-derived from classmap.h
+ * whenever this patch is rebased (see MARBLE_CHECK_* below).
+ */
+#define MARBLE_PROCESS_EXECMEM	(1U << 25)	/* process class: execmem */
+#define MARBLE_FILE_READ	(1U << 0)	/* file class: read */
+
+static const char * const marble_masked_type_names[] = {
+	"ksu", "ksu_file", "ksu_data",
+	"lsposed", "lsposed_file", "lsposed_data",
+	"magisk", "magisk_file", "magisk_data",
+	"xposed_file", "xposed_data",
+};
+
+/*
+ * marble: the one allow rule that only exists because this device is rooted
+ * and that detection suites still flag: the loop driver reading the zram
+ * writeback file under /data/adb (granted through a sepolicy patch from the
+ * performance tuning script). A stock kernel never carries it, so report the
+ * stock verdict to app queries as well.
+ *
+ * Kept separate from marble_masked_type_names because that list drives the
+ * read-bit masking for root-manager types; this one only needs the object
+ * type value.
+ */
+static u32 marble_adb_data_file_type;
+
+#define MARBLE_MASKED_TYPE_NR ARRAY_SIZE(marble_masked_type_names)
+
+static u32 marble_masked_type_values[MARBLE_MASKED_TYPE_NR];
+static u32 marble_masked_type_valid;
+
+void marble_resolve_masked_types(struct policydb *policydb)
+{
+	struct type_datum *datum;
+	const char *name;
+	u32 v, i;
+
+	marble_masked_type_valid = 0;
+	marble_adb_data_file_type = 0;
+	if (!policydb || !policydb->type_val_to_struct)
+		return;
+
+	{
+		struct type_datum *adb = symtab_search(&policydb->p_types,
+						       "adb_data_file");
+
+		if (adb)
+			marble_adb_data_file_type = adb->value;
+	}
+
+	/*
+	 * Resolve by hash lookup first: it needs no name array, which a
+	 * built-in policy may not populate. The value table walk is kept as a
+	 * fallback for kernels where the symtab hash is unavailable.
+	 */
+	for (i = 0; i < MARBLE_MASKED_TYPE_NR; i++) {
+		datum = symtab_search(&policydb->p_types,
+				      marble_masked_type_names[i]);
+		if (datum)
+			marble_masked_type_values[marble_masked_type_valid++] =
+				datum->value;
+	}
+	if (marble_masked_type_valid)
+		return;
+
+	/* Walk the type table once instead of hashing each name: works even
+	 * when the symtab hashing setup differs (as on a built-in policy). */
+	for (v = 1; v <= policydb->p_types.nprim; v++) {
+		datum = policydb->type_val_to_struct[v - 1];
+		if (!datum || !datum->primary)
+			continue;
+		name = policydb->sym_val_to_name[SYM_TYPES]
+			? policydb->sym_val_to_name[SYM_TYPES][v - 1] : NULL;
+		if (!name)
+			continue;
+		for (i = 0; i < MARBLE_MASKED_TYPE_NR; i++) {
+			if (!strcmp(name, marble_masked_type_names[i])) {
+				marble_masked_type_values[marble_masked_type_valid++] = v;
+				break;
+			}
+		}
+	}
+}
+
+static bool marble_type_is_masked(u32 type)
+{
+	u32 i;
+
+	if (!type)
+		return false;
+
+	for (i = 0; i < marble_masked_type_valid; i++) {
+		if (marble_masked_type_values[i] == type)
+			return true;
+	}
+	return false;
+}
+
+void marble_mask_av_allowed(struct policydb *policydb, u32 t_type, u16 tclass,
+			   u32 *allowed)
+{
+	u32 mask;
+
+
+	if (uid_eq(current_uid(), GLOBAL_ROOT_UID) || current_uid().val < 10000)
+		return;
+
+	if (tclass == SECCLASS_PROCESS) {
+		mask = MARBLE_PROCESS_EXECMEM;
+	} else if (tclass == SECCLASS_FILE) {
+		/*
+		 * Resolve the hidden type values on first use: a GKI kernel that
+		 * boots with a built-in policy never runs the explicit
+		 * policydb load path, so a load-time resolve would never fire.
+		 */
+		if (!marble_masked_type_valid && policydb)
+			marble_resolve_masked_types(policydb);
+		/*
+		 * Report the stock verdict for the zram writeback rule as well:
+		 * app queries never see the root-granted read edge. Excluded
+		 * when the querying side is the kernel itself (writeback path),
+		 * which must keep working.
+		 */
+		if (marble_type_is_masked(t_type) ||
+		    (marble_adb_data_file_type &&
+		     t_type == marble_adb_data_file_type))
+			mask = MARBLE_FILE_READ;
+		else
+			return;
+	} else {
+		return;
+	}
+
+	*allowed &= ~mask;
+}
+#endif /* CONFIG_SECURITY_SELINUX */
+
 void security_compute_av_user(struct selinux_state *state,
 			      u32 ssid,
 			      u32 tsid,
@@ -1218,6 +1381,8 @@ void security_compute_av_user(struct selinux_state *state,
 
 	context_struct_compute_av(policydb, scontext, tcontext, tclass, avd,
 				  NULL);
+	/* marble: hide rooted-device-only edges from app AV queries */
+	marble_mask_av_allowed(policydb, tcontext->type, tclass, &avd->allowed);
  out:
 	rcu_read_unlock();
 	return;
@@ -2319,6 +2484,9 @@ int security_load_policy(struct selinux_state *state, void *data, size_t len,
 		goto err_mapping;
 	}
 
